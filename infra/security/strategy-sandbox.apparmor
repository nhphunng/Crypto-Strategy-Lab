#include <tunables/global>
profile crypto-lab-strategy-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network deny,
  capability deny,
  deny /proc/** wklx,
  deny /sys/** rwklx,
  /usr/local/bin/python3.12 ix,
  /usr/local/lib/python3.12/** r,
  /runner/runner.py r,
  /sandbox/artifact.py r,
  /tmp/** rw,
}
