# Local-only, non-secret defaults. Copy to .env and override as needed.
CSL_ENVIRONMENT=development
CSL_DATABASE_URL=postgresql+asyncpg://crypto_lab:crypto_lab@localhost:55432/crypto_lab
CSL_POSTGRES_PORT=55432
CSL_API_PORT=8000

# Public provider endpoints only. Do not add credentials, tokens, or query secrets.
CSL_BINANCE_BASE_URL=https://api.binance.com
CSL_BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws

# Historical provider request policy.
CSL_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
CSL_PROVIDER_READ_TIMEOUT_SECONDS=10
CSL_PROVIDER_MAX_ATTEMPTS=3
CSL_PROVIDER_MAX_RETRY_DELAY_SECONDS=30

# Realtime provider health and bounded reconnect policy.
CSL_PROVIDER_HEARTBEAT_INTERVAL_SECONDS=15
CSL_PROVIDER_STALE_AFTER_SECONDS=30
CSL_PROVIDER_RECONNECT_INITIAL_DELAY_SECONDS=1
CSL_PROVIDER_RECONNECT_MAX_DELAY_SECONDS=30
CSL_PROVIDER_RECONNECT_JITTER_RATIO=0.20
CSL_PROVIDER_RECONNECT_MAX_ATTEMPTS=8

# Bounded historical bootstrap and dashboard connection limits.
CSL_MAX_RANGE_CANDLES=1000
CSL_DEFAULT_RANGE_CANDLES=500
CSL_MAX_CHART_SLOTS_PER_CONNECTION=4

CSL_MAX_DATASET_CANDLES=10000
CSL_DATASET_BUILD_LEASE_SECONDS=120
CSL_LOG_LEVEL=INFO

# Generated strategy isolation. Install the reviewed AppArmor profile on supported Linux hosts only.
CSL_STRATEGY_SANDBOX_IMAGE=crypto-lab-strategy-sandbox:1
# CSL_STRATEGY_SANDBOX_APPARMOR_PROFILE=crypto-lab-strategy-sandbox

# Generated-strategy deployment (use with docker-compose.generated.yml).
# Secrets are file paths and MUST stay outside version control. Do not put secret values here.
# CSL_LLM_ENDPOINT=https://provider.example/v1/strategy-generation
# CSL_LLM_PROVIDER=configured-provider
# CSL_LLM_MODEL_ID=provider-model-id
# CSL_LLM_MODEL_VERSION=provider-model-version
# CSL_LLM_API_KEY_FILE=/run/secrets/llm_api_key
# CSL_LLM_DATA_POLICY_CONFIRMED=true
# CSL_SOURCE_ENCRYPTION_KEY_FILE=/run/secrets/source_encryption_key
# CSL_SOURCE_ENCRYPTION_KEY_ID=deployment-key-v1
# CSL_GENERATED_ARTIFACT_ROOT=/var/lib/crypto-lab/generated-strategies
# CSL_STRATEGY_SANDBOX_ENGINE_URL=http://sandbox-docker:2375
