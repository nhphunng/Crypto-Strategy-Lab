# Local-only, non-secret defaults. Copy to .env and override as needed.
CSL_ENVIRONMENT=development
CSL_DATABASE_URL=postgresql+asyncpg://crypto_lab:crypto_lab@localhost:55432/crypto_lab
CSL_POSTGRES_PORT=55432
CSL_BINANCE_BASE_URL=https://api.binance.com
CSL_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
CSL_PROVIDER_READ_TIMEOUT_SECONDS=10
CSL_PROVIDER_MAX_ATTEMPTS=3
CSL_PROVIDER_MAX_RETRY_DELAY_SECONDS=30
CSL_MAX_RANGE_CANDLES=1000
CSL_DEFAULT_RANGE_CANDLES=500
CSL_MAX_DATASET_CANDLES=10000
CSL_DATASET_BUILD_LEASE_SECONDS=120
CSL_LOG_LEVEL=INFO
